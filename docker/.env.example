# ==========================================
# POSTGRESQL (Core Database)
# ==========================================
# Local Docker Setup
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=ontime_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}

# Cloud Setup (Neon.tech) - Uncomment to use Cloud
# DATABASE_URL=postgresql://<user>:<password>@<neon_hostname>/<dbname>?sslmode=require

# ==========================================
# SERVICE URLS / PORTS
# ==========================================
API_GATEWAY_SERVICE_PORT=8000
API_GATEWAY_ROUTE_SERVICE_URL=http://route-service:8002
API_GATEWAY_FLEET_SERVICE_URL=http://fleet-management-service:8003
API_GATEWAY_REDIS_URL=redis://redis:6379/0
API_GATEWAY_AUTH_SERVICE_URL=http://auth-service:8005
API_GATEWAY_POSTGRES_HOST=postgres
API_GATEWAY_POSTGRES_PORT=5432
API_GATEWAY_REDIS_HOST=redis
API_GATEWAY_REDIS_PORT=6379
API_GATEWAY_KAFKA_HOST=broker
API_GATEWAY_KAFKA_PORT=29092
API_GATEWAY_INFLUXDB_HOST=influxdb
API_GATEWAY_INFLUXDB_PORT=8086

ROUTE_SERVICE_PORT=8002
ROUTE_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

FLEET_SERVICE_PORT=8003
FLEET_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/fleet_db
FLEET_ROUTE_SERVICE_URL=http://route-service:8002
FLEET_ROUTE_SERVICE_TIMEOUT_SECONDS=3.0
FLEET_KAFKA_BROKER_URL=broker:29092
FLEET_KAFKA_TRIP_LIFECYCLE_TOPIC=trip.lifecycle

# ==========================================
# INFLUXDB (Time-Series Telemetry)
# ==========================================
# Local Docker Setup
INFLUXDB_INIT_MODE=setup
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=adminpassword
INFLUXDB_INIT_ORG=ontime
INFLUXDB_INIT_BUCKET=telemetry
INFLUXDB_ADMIN_TOKEN=your_super_secret_auth_token
INFLUXDB_URL=http://influxdb:8086

# Cloud Setup (InfluxDB Cloud) - Uncomment to use Cloud
# INFLUXDB_URL=https://us-east-1-1.aws.cloud2.influxdata.com
# INFLUXDB_ADMIN_TOKEN=your_cloud_all_access_token
# INFLUXDB_INIT_ORG=your_cloud_org_name
# INFLUXDB_INIT_BUCKET=telemetry

# ==========================================
# REDIS (Live Cache & WebSockets)
# ==========================================
# Local Docker Setup
REDIS_URL=redis://redis:6379
WEBSOCKET_SERVICE_PORT=8004
WEBSOCKET_REDIS_URL=redis://redis:6379
WEBSOCKET_FLEET_CHANNEL=fleet:live
WEBSOCKET_ETA_CHANNEL=eta:live
WEBSOCKET_ANOMALY_CHANNEL=anomaly:live

# Cloud Setup (Upstash Redis) - Uncomment to use Cloud
# REDIS_URL=rediss://default:<password>@<upstash_hostname>:<port>

# ==========================================
# KAFKA / AUTOMQ (Message Broker)
# ==========================================
# Local Docker Setup (KRaft)
KAFKA_BROKER_URL=broker:29092
STREAM_KAFKA_BROKER_URL=broker:29092
STREAM_KAFKA_RAW_TOPIC=transport-telemetry-raw
STREAM_KAFKA_CLEANED_TOPIC=transport-telemetry-cleaned
STREAM_KAFKA_INVALID_TOPIC=telemetry-invalid
STREAM_KAFKA_LIFECYCLE_TOPIC=trip.lifecycle
STREAM_KAFKA_CONSUMER_GROUP=stream-processing-group
STREAM_KAFKA_LIFECYCLE_CONSUMER_GROUP=stream-processing-lifecycle-group

# Cloud Setup (Upstash Kafka / Confluent / AutoMQ) - Uncomment to use Cloud
# KAFKA_BROKER_URL=<your_cloud_broker_url>:9092
# KAFKA_SASL_USERNAME=<your_cluster_username>
# KAFKA_SASL_PASSWORD=<your_cluster_password>
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256 # Or PLAIN depending on provider

# ==========================================
# MQTT Broker (Mosquitto / HiveMQ Cloud)
# ==========================================
# Local Docker Setup
# MQTT_BROKER_HOST=mqtt-broker
# MQTT_BROKER_PORT=1883

# HiveMQ Cloud Setup (Recommended for Simulation)
MQTT_BROKER_HOST=94f82b369e4a40e3a5f0725c0850c6f4.s1.eu.hivemq.cloud
MQTT_BROKER_PORT=8883
MQTT_USERNAME=chamodh
MQTT_PASSWORD=Noobmaster69
MQTT_TLS_ENABLED=true

MQTT_TOPIC_PATTERN=transport/bus/+/location
INGESTION_MQTT_BROKER_HOST=${MQTT_BROKER_HOST}
INGESTION_MQTT_BROKER_PORT=${MQTT_BROKER_PORT}
INGESTION_MQTT_TOPIC_PATTERN=transport/bus/+/location
INGESTION_MQTT_HEARTBEAT_TOPIC_PATTERN=transport/bus/+/heartbeat
INGESTION_MQTT_TLS_ENABLED=${MQTT_TLS_ENABLED}
INGESTION_MQTT_CLIENT_ID=ontime-ingestion-service
INGESTION_MQTT_USERNAME=${MQTT_USERNAME}
INGESTION_MQTT_PASSWORD=${MQTT_PASSWORD}
# INGESTION_MQTT_CA_CERT_PATH=/certs/mqtt-ca.pem

# NODE-RED
NODERED_PORT=1880
INGESTION_KAFKA_BROKER_URL=broker:29092
INGESTION_KAFKA_RAW_TOPIC=transport-telemetry-raw
INGESTION_KAFKA_DLQ_TOPIC=transport-telemetry-dlq
INGESTION_KAFKA_TRIP_LIFECYCLE_TOPIC=trip.lifecycle
INGESTION_TRIP_CACHE_CONSUMER_GROUP=ingestion-trip-cache
INGESTION_REQUIRE_ACTIVE_TRIP=true
INGESTION_TRIP_CACHE_REBUILD_TIMEOUT_SECONDS=60.0
INGESTION_STARTUP_BUFFER_MAX_MESSAGES=1000
INGESTION_SERVICE_PORT=8001
INGESTION_MIN_MESSAGE_INTERVAL_SECONDS=3.0
INGESTION_MIN_EVENT_INTERVAL_SECONDS=1.0
INGESTION_MAX_FUTURE_SKEW_SECONDS=30.0
INGESTION_MAX_STALE_AGE_SECONDS=86400.0
INGESTION_DUPLICATE_CACHE_SIZE=100
INGESTION_STATELESS_MODE=true

# ==========================================
# STREAM PROCESSING / FLINK
# ==========================================
STREAM_REDIS_HOST=redis
STREAM_REDIS_PORT=6379
STREAM_REDIS_FLEET_LIVE_CHANNEL=fleet:live
STREAM_INFLUXDB_URL=http://influxdb:8086
STREAM_INFLUXDB_TOKEN=${INFLUXDB_ADMIN_TOKEN}
STREAM_INFLUXDB_ORG=ontime
STREAM_INFLUXDB_BUCKET=telemetry
STREAM_ROUTE_SERVICE_URL=http://route-service:8002
STREAM_FLEET_SERVICE_URL=http://fleet-management-service:8003
STREAM_FLINK_PARALLELISM=1

# ==========================================
# ETA SERVICE
# ==========================================
ETA_SERVICE_PORT=8005
ETA_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/eta_db
ETA_KAFKA_BROKER_URL=broker:29092
ETA_KAFKA_TOPIC=transport-eta-features
ETA_KAFKA_CONSUMER_GROUP=eta-service-group
ETA_DEFAULT_MODEL=xgboost
ETA_REDIS_HOST=redis
ETA_REDIS_PORT=6379
ETA_LIVE_CHANNEL=eta:live
ETA_SNAPSHOT_TTL_SECONDS=300
ETA_SARIMA_MIN_HOURS=48
ETA_SARIMA_ARTIFACT_DIR=/app/sarima_artifacts
ETA_XGB_ARTIFACT_PATH=/app/models/training/eta_model_xgb.joblib
ETA_RECORDS_RETENTION_MONTHS=6

# ==========================================
# ANOMALY SERVICE
# ==========================================
ANOMALY_SERVICE_PORT=8006
ANOMALY_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/anomaly_db
ANOMALY_KAFKA_BROKER_URL=broker:29092
ANOMALY_KAFKA_CLEANED_TOPIC=transport-telemetry-cleaned
ANOMALY_KAFKA_DLQ_TOPIC=transport-telemetry-dlq
ANOMALY_KAFKA_ALERTS_TOPIC=transport-anomaly-alerts
ANOMALY_KAFKA_CLEANED_GROUP_ID=anomaly-service-group
ANOMALY_KAFKA_DLQ_GROUP_ID=anomaly-service-dlq-group
ANOMALY_ROUTE_SERVICE_URL=http://route-service:8002
ANOMALY_ROUTE_FETCH_TIMEOUT_SECONDS=10.0
ANOMALY_ROUTE_REFRESH_INTERVAL_SECONDS=300
ANOMALY_REDIS_HOST=redis
ANOMALY_REDIS_PORT=6379
ANOMALY_REDIS_LIVE_CHANNEL=anomaly:live
ANOMALY_COMMUNICATION_LOSS_CHECK_INTERVAL_SECONDS=60
ANOMALY_COMMUNICATION_LOSS_THRESHOLD_SECONDS=180
ANOMALY_INACTIVE_TRIP_DLQ_THRESHOLD_COUNT=3
ANOMALY_INACTIVE_TRIP_DLQ_WINDOW_SECONDS=60
ANOMALY_INACTIVE_TRIP_DLQ_COOLDOWN_SECONDS=300
ANOMALY_OFF_ROUTE_DISTANCE_THRESHOLD_M=50
ANOMALY_OFF_ROUTE_STREAK_WINDOW_SECONDS=5
ANOMALY_PERSISTENT_OFF_ROUTE_THRESHOLD=3
ANOMALY_SLIDING_WINDOW_SIZE=20
ANOMALY_SLIDING_WINDOW_MIN_SIZE=10
ANOMALY_ISOLATION_FOREST_ARTIFACT_PATH=/opt/anomaly-service/app/models/training/isolation_forest.joblib

# Cloud Setup (HiveMQ / EMQX) - Uncomment to use Cloud
# MQTT_BROKER_HOST=<your_cloud_mqtt_host>
# MQTT_BROKER_PORT=8883
# MQTT_USERNAME=<your_mqtt_username>
# MQTT_PASSWORD=<your_mqtt_password>
# MQTT_PASSWORD=<your_mqtt_password>

# ==========================================
# KEYCLOAK (IAM)
# ==========================================
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=ontime
KEYCLOAK_CLIENT_ID=ontime-auth-service
KEYCLOAK_CLIENT_SECRET=your_client_secret
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
