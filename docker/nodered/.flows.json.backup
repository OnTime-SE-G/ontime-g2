[
    {
        "id": "tab_simulation",
        "type": "tab",
        "label": "Bus Simulation",
        "disabled": false,
        "info": ""
    },
    {
        "id": "tls_config",
        "type": "tls-config",
        "name": "HiveMQ TLS",
        "cert": "",
        "key": "",
        "ca": "",
        "certname": "",
        "keyname": "",
        "caname": "",
        "servername": "94f82b369e4a40e3a5f0725c0850c6f4.s1.eu.hivemq.cloud",
        "verifyservercert": true,
        "alpn": ""
    },
    {
        "id": "mqtt_broker",
        "type": "mqtt-broker",
        "name": "HiveMQ Cloud",
        "broker": "94f82b369e4a40e3a5f0725c0850c6f4.s1.eu.hivemq.cloud",
        "port": "8883",
        "tls": "tls_config",
        "clientid": "ontime-sim-node-red",
        "usetls": true,
        "compatmode": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true,
        "birthTopic": "",
        "birthQos": "0",
        "birthPayload": "",
        "closeTopic": "",
        "closeQos": "0",
        "closePayload": "",
        "willTopic": "",
        "willQos": "0",
        "willPayload": "",
        "credentials": {
            "user": "${MQTT_USERNAME}",
            "password": "${MQTT_PASSWORD}"
        }
    },
    {
        "id": "startup_trigger",
        "type": "inject",
        "z": "tab_simulation",
        "name": "On Startup",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": true,
        "onceDelay": "2",
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 130,
        "y": 60,
        "wires": [
            [
                "kml_reader"
            ]
        ]
    },
    {
        "id": "kml_reader",
        "type": "file in",
        "z": "tab_simulation",
        "name": "Read KML",
        "filename": "/data/kml/202_gampaha_kirindiwela.kml",
        "format": "utf8",
        "chunk": false,
        "sendError": false,
        "encoding": "none",
        "allProps": false,
        "x": 300,
        "y": 60,
        "wires": [
            [
                "xml_parser"
            ]
        ]
    },
    {
        "id": "xml_parser",
        "type": "xml",
        "z": "tab_simulation",
        "name": "",
        "property": "payload",
        "attr": "",
        "chr": "",
        "x": 470,
        "y": 60,
        "wires": [
            [
                "kml_logic"
            ]
        ]
    },
    {
        "id": "kml_logic",
        "type": "function",
        "z": "tab_simulation",
        "name": "Extract Coordinates",
        "func": "let kml = msg.payload;\nlet coordinatesStr = \"\";\ntry {\n    let document = kml.kml.Document[0];\n    let folder = document.Folder.find(f => f.Placemark && f.Placemark[0].LineString);\n    if (!folder && document.Folder[1]) folder = document.Folder[1];\n\n    let placemark = folder.Placemark[0];\n    coordinatesStr = placemark.LineString[0].coordinates[0];\n} catch (e) {\n    node.error(\"Failed to parse KML: \" + e.message);\n    return null;\n}\n\nlet coords = coordinatesStr.trim().split(/\\s+/).map(c => {\n    let parts = c.split(',');\n    return {\n        lon: parseFloat(parts[0]),\n        lat: parseFloat(parts[1])\n    };\n}).filter(p => !isNaN(p.lat) && !isNaN(p.lon));\n\nflow.set(\"coordinates\", coords);\nflow.set(\"index\", 0);\nnode.status({fill:\"green\",shape:\"dot\",text:\"Loaded \" + coords.length + \" points\"});\nreturn { payload: \"KML Loaded: \" + coords.length + \" points\" };",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 680,
        "y": 60,
        "wires": [
            [
                "debug_out"
            ]
        ]
    },
    {
        "id": "ticker",
        "type": "inject",
        "z": "tab_simulation",
        "name": "Every 5s",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "5",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 130,
        "y": 160,
        "wires": [
            [
                "sim_logic"
            ]
        ]
    },
    {
        "id": "sim_logic",
        "type": "function",
        "z": "tab_simulation",
        "name": "GPS Simulator",
        "func": "let coords = flow.get(\"coordinates\");\nlet index = flow.get(\"index\") || 0;\n\nif (!coords || coords.length === 0) {\n    node.status({fill:\"red\",shape:\"ring\",text:\"No coordinates loaded\"});\n    return null;\n}\n\nlet point = coords[index];\nlet nextIndex = (index + 1) % coords.length;\nflow.set(\"index\", nextIndex);\n\nlet heading = 0;\nif (index > 0) {\n    let prev = coords[index - 1];\n    heading = Math.atan2(point.lon - prev.lon, point.lat - prev.lat) * 180 / Math.PI;\n    if (heading < 0) heading += 360;\n}\n\nmsg.payload = {\n    busId: \"BUS001\",\n    lat: point.lat,\n    lon: point.lon,\n    speed: 40.0 + Math.random() * 10,\n    heading: Math.round(heading),\n    timestamp: new Date().toISOString()\n};\n\nmsg.topic = \"transport/bus/BUS001/location\";\nnode.status({fill:\"blue\",shape:\"dot\",text:\"Point \" + index + \"/\" + coords.length});\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
        "y": 160,
        "wires": [
            [
                "mqtt_out",
                "debug_out"
            ]
        ]
    },
    {
        "id": "mqtt_out",
        "type": "mqtt out",
        "z": "tab_simulation",
        "name": "Publish Telemetry",
        "topic": "",
        "qos": "0",
        "retain": "",
        "respTopic": "",
        "contentType": "",
        "userProps": "",
        "correl": "",
        "expiry": "",
        "broker": "mqtt_broker",
        "x": 550,
        "y": 160,
        "wires": []
    },
    {
        "id": "hb_ticker",
        "type": "inject",
        "z": "tab_simulation",
        "name": "Every 30s",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "30",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 130,
        "y": 240,
        "wires": [
            [
                "hb_logic"
            ]
        ]
    },
    {
        "id": "hb_logic",
        "type": "function",
        "z": "tab_simulation",
        "name": "Heartbeat",
        "func": "msg.payload = {\n    busId: \"BUS001\",\n    timestamp: new Date().toISOString()\n};\nmsg.topic = \"transport/bus/BUS001/heartbeat\";\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 310,
        "y": 240,
        "wires": [
            [
                "mqtt_out"
            ]
        ]
    },
    {
        "id": "debug_out",
        "type": "debug",
        "z": "tab_simulation",
        "name": "Debug",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "false",
        "statusVal": "",
        "statusType": "auto",
        "x": 850,
        "y": 160,
        "wires": []
    },
    {
        "id": "error_catch",
        "type": "catch",
        "z": "tab_simulation",
        "name": "Catch Errors",
        "scope": null,
        "uncaught": false,
        "x": 130,
        "y": 320,
        "wires": [
            [
                "debug_out"
            ]
        ]
    }
]