[
    {
        "id": "live_simulation_flow",
        "type": "tab",
        "label": "Live Site Simulation",
        "disabled": false,
        "info": "Points at on-time.live + HiveMQ LoadBalancer for staging tests."
    },
    {
        "id": "live_trigger",
        "type": "inject",
        "z": "live_simulation_flow",
        "name": "Start Live Trip Simulation",
        "props": [{"p": "payload"}],
        "repeat": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "{\"username\":\"driver1\", \"password\":\"password\"}",
        "payloadType": "json",
        "x": 170,
        "y": 80,
        "wires": [["live_get_token"]]
    },
    {
        "id": "live_get_token",
        "type": "http request",
        "z": "live_simulation_flow",
        "name": "Keycloak Login (live)",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "https://on-time.live/auth/realms/ontime/protocol/openid-connect/token",
        "tls": "",
        "persist": false,
        "proxy": "",
        "headers": [
            {"keyType": "Content-Type", "keyValue": "application/x-www-form-urlencoded", "valueType": "str"}
        ],
        "x": 400,
        "y": 80,
        "wires": [["live_prepare_token"]]
    },
    {
        "id": "live_prepare_token",
        "type": "function",
        "z": "live_simulation_flow",
        "name": "Build token request",
        "func": "msg.headers = {'Content-Type': 'application/x-www-form-urlencoded'};\nmsg.payload = 'grant_type=password&client_id=ontime-api&client_secret=secret&username=driver1&password=password';\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 200,
        "y": 140,
        "wires": [["live_get_token_retry"]]
    },
    {
        "id": "live_get_token_retry",
        "type": "http request",
        "z": "live_simulation_flow",
        "name": "POST token",
        "method": "use",
        "ret": "obj",
        "url": "",
        "x": 420,
        "y": 140,
        "wires": [["live_extract_token"]]
    },
    {
        "id": "live_extract_token",
        "type": "function",
        "z": "live_simulation_flow",
        "name": "Extract Token",
        "func": "if (!msg.payload || !msg.payload.access_token) {\n    node.error('Token failed: ' + JSON.stringify(msg.payload));\n    return null;\n}\nmsg.token = msg.payload.access_token;\nmsg.headers = { Authorization: 'Bearer ' + msg.token };\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 620,
        "y": 140,
        "wires": [["live_get_trips_fn"]]
    },
    {
        "id": "live_get_trips_fn",
        "type": "function",
        "z": "live_simulation_flow",
        "name": "Prepare trips URL",
        "func": "msg.url = 'https://on-time.live/api/v1/driver/trips/today';\nmsg.method = 'GET';\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 200,
        "y": 220,
        "wires": [["live_fetch_trips"]]
    },
    {
        "id": "live_fetch_trips",
        "type": "http request",
        "z": "live_simulation_flow",
        "name": "Fetch Trips",
        "method": "use",
        "ret": "obj",
        "url": "",
        "x": 420,
        "y": 220,
        "wires": [["live_start_trip_fn"]]
    },
    {
        "id": "live_start_trip_fn",
        "type": "function",
        "z": "live_simulation_flow",
        "name": "Start trip + route",
        "func": "const trips = Array.isArray(msg.payload) ? msg.payload : (msg.payload.items || []);\nif (!trips.length) { node.error('No trips'); return null; }\nconst trip = trips[0];\nmsg.trip_id = trip.id || trip.tripId;\nmsg.bus_id = trip.bus_id || trip.busId;\nmsg.route_id = trip.route_id || trip.routeId;\nmsg.url = 'https://on-time.live/api/v1/driver/trips/' + msg.trip_id + '/start';\nmsg.method = 'POST';\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 640,
        "y": 220,
        "wires": [["live_start_trip"]]
    },
    {
        "id": "live_start_trip",
        "type": "http request",
        "z": "live_simulation_flow",
        "name": "Start Trip",
        "method": "use",
        "ret": "obj",
        "url": "",
        "x": 200,
        "y": 300,
        "wires": [["live_route_fn"]]
    },
    {
        "id": "live_route_fn",
        "type": "function",
        "z": "live_simulation_flow",
        "name": "Fetch route geometry",
        "func": "msg.url = 'https://on-time.live/api/v1/routes/' + msg.route_id;\nmsg.method = 'GET';\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 220,
        "y": 380,
        "wires": [["live_fetch_route"]]
    },
    {
        "id": "live_fetch_route",
        "type": "http request",
        "z": "live_simulation_flow",
        "name": "Fetch Route",
        "method": "use",
        "ret": "obj",
        "url": "",
        "x": 450,
        "y": 380,
        "wires": [["live_stream_gps"]]
    },
    {
        "id": "live_stream_gps",
        "type": "function",
        "z": "live_simulation_flow",
        "name": "Stream GPS to HiveMQ",
        "func": "const geojson = msg.payload;\nconst routeFeature = (geojson.features || []).find(f => f.properties && f.properties.feature_type === 'route');\nif (!routeFeature) { node.error('No route geometry'); return null; }\nconst coords = routeFeature.geometry.coordinates;\nconst bus_id = String(msg.bus_id);\nconst trip_id = msg.trip_id;\nlet i = 0;\nconst interval = setInterval(() => {\n    if (i >= coords.length) { clearInterval(interval); return; }\n    const [lon, lat] = coords[i];\n    node.send({\n        topic: 'transport/bus/' + bus_id + '/location',\n        payload: {\n            busId: bus_id,\n            tripId: trip_id,\n            routeId: String(msg.route_id),\n            lat, lon,\n            speed: 12 + Math.random() * 8,\n            heading: (i * 15) % 360,\n            timestamp: new Date().toISOString()\n        }\n    });\n    i++;\n}, 3000);\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "x": 680,
        "y": 380,
        "wires": [["live_mqtt_out"]]
    },
    {
        "id": "live_mqtt_out",
        "type": "mqtt out",
        "z": "live_simulation_flow",
        "name": "MQTT Out (HiveMQ)",
        "topic": "",
        "qos": "1",
        "retain": "",
        "broker": "live_mqtt_broker",
        "x": 920,
        "y": 380,
        "wires": []
    },
    {
        "id": "live_mqtt_broker",
        "type": "mqtt-broker",
        "name": "HiveMQ Live",
        "broker": "168.144.48.110",
        "port": "1883",
        "clientid": "nodered-live-simulator",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true
    }
]
