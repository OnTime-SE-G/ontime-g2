#include <SoftwareSerial.h>
#include <TinyGPS++.h>

// GPS connected to D4 (RX), D5 (TX)
SoftwareSerial gpsSerial(4, 5);  // RX, TX
TinyGPSPlus gps;

void setup() {
  Serial.begin(9600);
  gpsSerial.begin(9600);

  Serial.println(F("GPS Test – waiting for fix..."));
  Serial.println(F("Place module outdoors with clear sky view."));
  delay(2000);
}

void loop() {
  // Feed all incoming NMEA sentences to the parser
  while (gpsSerial.available() > 0) {
    char c = gpsSerial.read();
    gps.encode(c);
    // Optional: print raw NMEA to see what the module is sending
    // Serial.write(c);
  }

  // Every second, report satellite count and fix status
  static unsigned long lastReport = 0;
  if (millis() - lastReport >= 1000) {
    lastReport = millis();

    Serial.print(F("Sats: "));
    Serial.print(gps.satellites.value());
    Serial.print(F("  HDOP: "));
    Serial.print(gps.hdop.value() / 100.0, 2);

    if (gps.location.isValid()) {
      Serial.print(F("  Lat: "));
      Serial.print(gps.location.lat(), 6);
      Serial.print(F("  Lng: "));
      Serial.print(gps.location.lng(), 6);
      Serial.print(F("  Alt: "));
      Serial.print(gps.altitude.meters());
    } else {
      Serial.print(F("  No fix yet"));
    }
    Serial.println();
  }
}