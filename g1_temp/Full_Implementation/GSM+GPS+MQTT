#define TINY_GSM_MODEM_SIM800
#include <TinyGsmClient.h>
#include <PubSubClient.h>
#include <SoftwareSerial.h>
#include <TinyGPS++.h>
#include <EEPROM.h>

const int ADDR_CONFIG = 0;

struct DeviceConfig {
  char busId[16];
  unsigned long locationIntervalMs;
  unsigned long heartbeatIntervalMs;
};

DeviceConfig config = {
  "1",      // Default Bus ID
  5000,     // Default Location Interval
  30000     // Default Heartbeat Interval
};

// OnTime G1 -> G2 contract:
// - GPS device sends busId and event-time GPS only.
// - GPS device does not send tripId.
// - G2 Ingestion resolves the active trip using busId + Kafka trip.lifecycle.
// - Live GPS messages must not be retained, otherwise old positions can replay.
// - Heartbeat messages report device status and may be retained.

// Network config
const char APN[] = "internet";
const char APN_USER[] = "";
const char APN_PASS[] = "";

// MQTT config
// Local Mosquitto example:
//   MQTT_BROKER = "test.mosquitto.org" or your local broker IP
//   MQTT_PORT   = 1883
// HiveMQ Cloud usually requires TLS on 8883. SIM800L TLS support must be
// confirmed before using HiveMQ Cloud directly from this firmware.
const char MQTT_BROKER[] = "test.mosquitto.org";
const int MQTT_PORT = 1883;
const char MQTT_USERNAME[] = "";
const char MQTT_PASSWORD[] = "";

// Device identity config
const char DEVICE_ID[] = "GPS-1";         // Hardcoded physical hardware ID
const char FIRMWARE_VERSION[] = "g1-0.1.0"; // Hardcoded firmware version

char clientId[32]; // Generated from DEVICE_ID
char locationTopic[96];
char heartbeatTopic[96];
char configTopic[96];

SoftwareSerial gsmSerial(3, 2);  // GSM RX=3, TX=2
SoftwareSerial gpsSerial(5, 4);  // GPS RX=5, TX=4

TinyGsm modem(gsmSerial);
TinyGsmClient gsmClient(modem);
PubSubClient mqtt(gsmClient);
TinyGPSPlus gps;

double lat = 0.0;
double lon = 0.0;
float speedKmph = 0.0;
float headingDeg = 0.0;
char timestampIso[25] = "";
bool gpsFixed = false;
bool timestampValid = false;
unsigned long lastHeartbeatAt = 0;

void readGPS() {
  gpsSerial.listen();

  unsigned long start = millis();
  while (millis() - start < 1000) {
    while (gpsSerial.available()) {
      gps.encode(gpsSerial.read());
    }
  }

  gpsFixed = false;
  timestampValid = false;
  timestampIso[0] = '\0';

  if (gps.location.isValid() && gps.location.age() < 2000) {
    lat = gps.location.lat();
    lon = gps.location.lng();
    speedKmph = gps.speed.isValid() ? gps.speed.kmph() : 0.0;
    headingDeg = gps.course.isValid() ? gps.course.deg() : 0.0;
    gpsFixed = true;
  }

  if (gps.date.isValid() && gps.time.isValid()) {
    snprintf(
      timestampIso,
      sizeof(timestampIso),
      "%04d-%02d-%02dT%02d:%02d:%02dZ",
      gps.date.year(),
      gps.date.month(),
      gps.date.day(),
      gps.time.hour(),
      gps.time.minute(),
      gps.time.second()
    );
    timestampValid = true;
  }
}

void connectGSM() {
  gsmSerial.listen();
  Serial.println("Initialising modem...");
  modem.restart();

  Serial.print("Modem: ");
  Serial.println(modem.getModemInfo());

  Serial.print("Waiting for network...");
  while (!modem.waitForNetwork()) {
    Serial.print(".");
    delay(1000);
  }
  Serial.println(" OK");

  Serial.print("Connecting to APN: ");
  Serial.println(APN);
  while (!modem.gprsConnect(APN, APN_USER, APN_PASS)) {
    Serial.print(".");
    delay(1000);
  }

  Serial.print("GPRS connected | IP: ");
  Serial.println(modem.localIP());
}

bool mqttConnectOnce() {
  if (strlen(MQTT_USERNAME) > 0) {
    return mqtt.connect(clientId, MQTT_USERNAME, MQTT_PASSWORD);
  }

  return mqtt.connect(clientId);
}

void connectMQTT() {
  gsmSerial.listen();
  mqtt.setServer(MQTT_BROKER, MQTT_PORT);

  Serial.print("Connecting to MQTT broker...");
  while (!mqttConnectOnce()) {
    Serial.print(".");
    delay(2000);
  }

  Serial.println(" connected!");
  mqtt.subscribe(configTopic);
  Serial.print("Subscribed to ");
  Serial.println(configTopic);
}

void publishHeartbeatIfDue(bool force = false) {
  unsigned long now = millis();
  if (!force && lastHeartbeatAt != 0 && now - lastHeartbeatAt < config.heartbeatIntervalMs) {
    return;
  }

  if (!timestampValid && !force) {
    Serial.println("Heartbeat skipped: waiting for valid GPS date/time...");
    return;
  }

  int signalQuality = modem.getSignalQuality();
  if (signalQuality < 0) {
    signalQuality = 0;
  }

  char heartbeatPayload[256];
  snprintf(
    heartbeatPayload,
    sizeof(heartbeatPayload),
    "{"
      "\"busId\":\"%s\","
      "\"deviceId\":\"%s\","
      "\"timestamp\":\"%s\","
      "\"gpsFix\":%s,"
      "\"satellites\":%lu,"
      "\"signalQuality\":%d,"
      "\"firmwareVersion\":\"%s\","
      "\"current_interval\":%lu"
    "}",
    config.busId,
    DEVICE_ID,
    timestampIso,
    gpsFixed ? "true" : "false",
    gps.satellites.value(),
    signalQuality,
    FIRMWARE_VERSION,
    config.locationIntervalMs
  );

  if (mqtt.publish(heartbeatTopic, heartbeatPayload, true)) {
    lastHeartbeatAt = now;
    Serial.print("Heartbeat: ");
    Serial.println(heartbeatPayload);
  } else {
    Serial.println("Heartbeat publish failed. Reconnecting...");
    connectMQTT();
  }
}

void mqttCallback(char* topic, byte* payload, unsigned int length) {
  String message = "";
  for (unsigned int i = 0; i < length; i++) {
    message += (char)payload[i];
  }
  
  Serial.print("Received MQTT Config: ");
  Serial.println(message);

  // Expecting format "B:2,I:10000,H:60000"
  // For simplicity on Nano, we check for presence of tags
  bool updated = false;
  
  int iIndex = message.indexOf("I:");
  if (iIndex != -1) {
    unsigned long newLoc = message.substring(iIndex + 2).toInt();
    if (newLoc >= 1000 && newLoc <= 60000) {
      config.locationIntervalMs = newLoc;
      updated = true;
    }
  }

  int hIndex = message.indexOf("H:");
  if (hIndex != -1) {
    unsigned long newHb = message.substring(hIndex + 2).toInt();
    if (newHb >= 10000 && newHb <= 300000) {
      config.heartbeatIntervalMs = newHb;
      updated = true;
    }
  }

  int bIndex = message.indexOf("B:");
  if (bIndex != -1) {
    int commaIndex = message.indexOf(",", bIndex);
    String newBus = (commaIndex == -1) ? message.substring(bIndex + 2) : message.substring(bIndex + 2, commaIndex);
    if (newBus.length() > 0 && newBus.length() < 16) {
      newBus.toCharArray(config.busId, 16);
      updated = true;
    }
  }

  if (updated) {
    EEPROM.put(ADDR_CONFIG, config);
    Serial.println("Config Applied & Saved to EEPROM!");
    publishHeartbeatIfDue(true);
  }
}

void setup() {
  Serial.begin(9600);
  gsmSerial.begin(9600);
  gpsSerial.begin(9600);

  // Load config from EEPROM
  DeviceConfig tempConfig;
  EEPROM.get(ADDR_CONFIG, tempConfig);
  
  // Basic validation to ensure EEPROM isn't empty/corrupted (uninitialized EEPROM is 0xFF)
  if (tempConfig.locationIntervalMs >= 1000 && tempConfig.locationIntervalMs <= 60000) {
    config = tempConfig;
  } else {
    // Save defaults on first boot
    EEPROM.put(ADDR_CONFIG, config);
  }

  // Generate unique Client ID from hardware Device ID
  snprintf(clientId, sizeof(clientId), "ontime-g1-%s", DEVICE_ID);

  snprintf(
    locationTopic,
    sizeof(locationTopic),
    "transport/bus/%s/location",
    config.busId
  );
  snprintf(
    heartbeatTopic,
    sizeof(heartbeatTopic),
    "transport/bus/%s/heartbeat",
    config.busId
  );
  snprintf(
    configTopic,
    sizeof(configTopic),
    "transport/bus/%s/config",
    config.busId
  );

  Serial.print("OnTime GPS topic: ");
  Serial.println(locationTopic);
  Serial.print("OnTime heartbeat topic: ");
  Serial.println(heartbeatTopic);

  mqtt.setCallback(mqttCallback);

  connectGSM();
  connectMQTT();
}

void loop() {
  readGPS();

  gsmSerial.listen();
  if (!mqtt.connected()) {
    connectMQTT();
  }
  mqtt.loop();
  publishHeartbeatIfDue();

  if (!gpsFixed) {
    Serial.print("Waiting for GPS fix... satellites: ");
    Serial.println(gps.satellites.value());
    delay(config.locationIntervalMs);
    return;
  }

  if (!timestampValid) {
    Serial.println("Waiting for valid GPS date/time...");
    delay(config.locationIntervalMs);
    return;
  }

  char latStr[14], lonStr[14], speedStr[8], headingStr[8];
  dtostrf(lat, 9, 6, latStr);
  dtostrf(lon, 9, 6, lonStr);
  dtostrf(speedKmph, 5, 1, speedStr);
  dtostrf(headingDeg, 5, 1, headingStr);

  char payload[224];
  snprintf(
    payload,
    sizeof(payload),
    "{"
      "\"busId\":\"%s\","
      "\"lat\":%s,"
      "\"lon\":%s,"
      "\"speed\":%s,"
      "\"heading\":%s,"
      "\"timestamp\":\"%s\""
    "}",
    config.busId,
    latStr,
    lonStr,
    speedStr,
    headingStr,
    timestampIso
  );

  if (mqtt.publish(locationTopic, payload, false)) {
    Serial.print("Published: ");
    Serial.println(payload);
  } else {
    Serial.println("Publish failed. Reconnecting...");
    connectMQTT();
  }

  delay(config.locationIntervalMs);
}
